<?xml version="1.0" encoding="UTF-8"?>
<!-- Launch file for maze_navigator package that starts the maze world, spawns TurtleBot3, and enables RRT exploration -->

<launch>

  <!-- Arguments that can be passed to this launch file -->
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="world_name" default="$(find plywood_mazes)/worlds/maze_3_6x6.world"/>
  
  <!-- TurtleBot3 model selection -->
  <arg name="model" default="burger" doc="model type [burger, waffle, waffle_pi]"/>
  
  <!-- Robot spawn position -->
  <arg name="x_pos" default="2.7"/>
  <arg name="y_pos" default="3.0"/>
  <arg name="z_pos" default="0.0"/>
  <arg name="yaw" default="1.57"/>

  <!-- RRT exploration parameters -->
  <arg name="eta" default="1.0"/>
  <arg name="Geta" default="15.0"/>

  <!-- Set TurtleBot3 model environment variable -->
  <env name="TURTLEBOT3_MODEL" value="$(arg model)" />

  <!-- Launch the plywood maze world -->
  <include file="$(find plywood_mazes)/launch/maze_3_6x6.launch">
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="$(arg use_sim_time)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="$(arg headless)" />
    <arg name="debug" value="$(arg debug)" />
  </include>

  <!-- Spawn TurtleBot3 robot -->
  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro" />
  
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf" 
        args="-urdf -model turtlebot3_$(arg model) -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos) -Y $(arg yaw) -param robot_description" />

  <!-- Robot state publisher -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="50.0" />
  </node>

  <!-- SLAM: Gmapping -->
  <include file="$(find turtlebot3_slam)/launch/turtlebot3_gmapping.launch">
    <arg name="model" value="$(arg model)" />
  </include>

  <!-- Navigation stack -->
  <include file="$(find turtlebot3_navigation)/launch/move_base.launch">
    <arg name="model" value="$(arg model)" />
  </include>

  <!-- RRT Exploration nodes with corrected topic names -->
  <param name="namespace_init_count" value="1"/>

  <!-- Global RRT detector -->
  <node pkg="rrt_exploration" type="global_rrt_detector" name="global_detector" output="screen">
    <param name="eta" value="$(arg Geta)"/>
    <param name="map_topic" value="/map"/>
  </node>
  
  <!-- Local RRT detector -->
  <node pkg="rrt_exploration" type="local_rrt_detector" name="local_detector" output="screen">
    <param name="eta" value="$(arg eta)"/>
    <param name="map_topic" value="/map"/>
    <param name="robot_frame" value="base_link"/>
  </node>
 
  <!-- Filter node -->
  <node pkg="rrt_exploration" type="filter.py" name="filter" output="screen">
    <param name="map_topic" value="/map"/>
    <param name="info_radius" value="1.0"/> 
    <param name="costmap_clearing_threshold" value="70"/> 
    <param name="goals_topic" value="/detected_points"/>
    <param name="namespace" value="robot_"/> 
    <param name="n_robots" value="1"/>
    <param name="rate" value="100"/>
    <!-- Auto boundary detection -->
    <param name="boundary" value="[[2.92, 3.40], [2.85, -2.41], [-2.2, -1.7], [-2.2, 2.8]]"/>
  </node>
  
  <!-- Assigner node - CRITICAL for autonomous exploration -->
  <node pkg="rrt_exploration" type="assigner.py" name="assigner" output="screen">
    <param name="map_topic" value="/map"/>
    <param name="global_frame" value="map"/>
    <param name="info_radius" value="1.0"/> 
    <param name="info_multiplier" value="3.0"/> 
    <param name="hysteresis_radius" value="3.0"/> 
    <param name="hysteresis_gain" value="2.0"/> 
    <param name="frontiers_topic" value="/filtered_points"/> 
    <param name="n_robots" value="1"/>
    <param name="namespace" value="robot_"/>
    <param name="delay_after_assignement" value="0.5"/>
    <param name="rate" value="100"/>
  </node>

  <!-- RViz for visualization -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find turtlebot3_slam)/rviz/turtlebot3_gmapping.rviz" />

</launch>
